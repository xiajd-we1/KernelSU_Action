CONFIG_ENV=config.env

# -------------------------- 内核源码配置 --------------------------
KERNEL_SOURCE=https://github.com/EndCredits/android_kernel_xiaomi_sm8350-miui
KERNEL_SOURCE_BRANCH=miui-base
KERNEL_CONFIG=vendor/venus_QGKI.config
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# -------------------------- 工具链【方案2完整实现】 ------------------------------
# git clone 获取 clang‑r450784e，完全抛弃 googlesource tar 下载
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/LineageOS/android_prebuilts_clang_host_linux-x86_clang-r450784e.git
CUSTOM_CLANG_BRANCH=main

# ==========方案2核心：开启完整LLVM编译，全部GCC禁用，消除GCC下载故障点==========
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false

# 5.4内核编译参数，ld.lld链接器，屏蔽严格原型报错
EXTRA_CMDS=LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# -------------------------- SukiSU‑Ultra LKM模式（5.4推荐LKM，避免builtin打补丁失败） ---------------------------
KSU_VARIANT=sukisu
KSU_REF=main
KSU_HOOK_MODE=lkm

ENABLE_SUSFS=false
ENABLE_KSU_SUSFS=false

# -------------------------- AnyKernel3打包 ----------------
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# -------------------------- Runner编译加速 ----------------
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
