# KernelSU_Action build profile for Mi11 venus SM8350 4.19
CONFIG_ENV=config.env

# -------------------------- Kernel Source --------------------------
KERNEL_SOURCE=https://github.com/EndCredits/android_kernel_xiaomi_sm8350-miui
KERNEL_SOURCE_BRANCH=miui-base
KERNEL_CONFIG=vendor/venus_QGKI.config
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# -------------------------- Toolchain ------------------------------
# 开启自定义clang，从GitHub镜像拉取，绕过googlesource 503错误
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/LineageOS/android_prebuilts_clang_host_linux-x86_clang-r450784e
CUSTOM_CLANG_BRANCH=master

USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# -------------------------- SukiSU‑Ultra ---------------------------
# 4.19非GKI使用legacy分支 + manual hook，避开builtin源码补丁冲突
KSU_VARIANT=sukisu-ultra
KSU_REF=legacy
KSU_HOOK_MODE=manual

ENABLE_SUSFS=false
ENABLE_KPM=false

ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true

ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true

DISABLE_LTO=true
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=CONFIG_KSU=y CONFIG_KPROBES=y CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y

# -------------------------- AnyKernel3 / Packaging ----------------
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# -------------------------- Runner --------------------------------
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
