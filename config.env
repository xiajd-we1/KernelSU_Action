# KernelSU Action -- build profile
#
# Values here are defaults; workflow_dispatch inputs override them per run.
# Only the exact string "true" (or yes/on/1) counts as enabled.
#
# Copy this file to config/<device>.env to keep one profile per device, then
# pick it with the "Config file to build" input when you start a build.

CONFIG_ENV=config.env

# ============================================================ Kernel source ==

# 修改为你的设备源码仓库 (优先使用 hushangda 的干净仓库)
KERNEL_SOURCE=https://github.com/hushangda/android_kernel_xiaomi_sm8350_venus
# 注意：请去该仓库查看默认分支名，通常为 main 或 sm8350-13，如果是其他请自行修改
KERNEL_SOURCE_BRANCH=main
KERNEL_CONFIG=venus_defconfig
# 5.4 内核一般编译出 Image 或者 Image.gz
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=venus

ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# 5.4 内核建议保持这个 Clang 版本，比较稳妥。如果报错可尝试换 main-kernel-2025 和 r547379
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 5.4 内核可以开启 LLVM，但如果你编译遇到问题，可以改回 false 用 GCC 配合
USE_LLVM=false

# ===================================================================== GCC ==

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

# 强烈建议使用 sukisu-ultra，搭配 builtin 分支，自带 SUSFS 支持，在 5.4 上比手动打补丁稳定得多
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin

# 5.4 内核使用 auto 会自动选择 kprobes 或 manual，一般没问题
KSU_HOOK_MODE=auto

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

# 如果使用 sukisu-ultra + builtin，SUSFS 是源码自带的，这里保持 false 即可，避免重复打补丁导致编译失败
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# 5.4 内核必须开启这个（path_umount 是 5.9 才引入的，5.4 需要手动 backport）
ENABLE_PATH_UMOUNT=true

# 开启额外的指纹和路径隐藏
ENABLE_HIDE_STUFF=true

ENABLE_KPM=false

# ================================================================ Kconfig ===

# 5.4 内核一般需要 kprobes
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

# 小米11 打包刷机包通常需要包含 dtbo
NEED_DTBO=true

# 不建议在此处直接 BUILD_BOOT_IMG，用 AnyKernel3 刷入更安全
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
